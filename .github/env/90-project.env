# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for the mixtape repository
# Load Order: 90 (loaded after all tool defaults, overrides earlier files)
#
# This file contains settings unique to this repository that should NOT be
# synced to other repos via go-broadcast. All values here override defaults
# from 00-core.env, 10-*.env, and 20-*.env files.
#
# Override in: 99-local.env (local development, gitignored)
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

GO_PRIMARY_VERSION=1.26.x
GO_SECONDARY_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x
MAGE_X_GO_VERSION=1.26.x

# ================================================================================================
# 🖥️ RUNNER CONFIGURATION
# ================================================================================================

# mixtape runs only on macOS, but the module builds and its tests pass on Linux:
# the Core Audio and AppleScript code sits behind darwin build tags, with stubs
# elsewhere. GoFortress (lint, tests, security scans) therefore uses the default
# Linux runners. The release build needs the macOS SDK for its cgo binaries, so
# the release job alone runs on macOS.
RELEASE_RUNNER=macos-15

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Use Codecov for coverage reporting (overrides 10-coverage.env default of 'internal').
# The upload token is the CODECOV_TOKEN repository secret.
GO_COVERAGE_PROVIDER=codecov
CODECOV_TOKEN_REQUIRED=true

# Coverage Exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,examples/,mocks/,docs/,.github/,.mage-cache/,.vscode/,bin/,example/,testing/

# ================================================================================================
# 🧰 MAGE-X CONFIGURATION
# ================================================================================================

# `magex build:dev` installs the binary where the README's install one-liner does
# (`magex install` uses $GOPATH/bin instead).
MAGE_X_INSTALL_DIR=~/.local/bin
